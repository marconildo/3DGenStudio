# Copy to .env next to docker-compose.yml, then edit. Never commit the result.

# Host port to publish the server on.
GENSTUDIO_PORT=3001

# REQUIRED — at least 16 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GENSTUDIO_JWT_SECRET=123456Secret123456Secret123456

# REQUIRED — the first administrator, created only while no user exists.
# The password must be at least 8 characters; the server refuses to start if it
# cannot create this account, because it would have no usable login at all.
GENSTUDIO_ADMIN_LOGIN=admin
GENSTUDIO_ADMIN_PASSWORD=12345678

# Set behind a reverse proxy so asset URLs point at the public address.
# PUBLIC_BASE_URL=https://studio.example.com

# X-Forwarded-* headers are TRUSTED BY DEFAULT. If this server is reachable
# directly (not via a proxy), set this to 0 so a client cannot spoof the host
# the API puts into asset URLs.
# TRUST_PROXY_HEADERS=0
