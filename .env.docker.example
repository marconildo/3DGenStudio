# Copy to .env next to docker-compose.yml, then edit. Never commit the result.

# Host port to publish the server on.
GENSTUDIO_PORT=3001

# --- Database ---------------------------------------------------------------
# The shared server runs on PostgreSQL: a team's requests have to be able to run
# in parallel, and SQLite serialises every one of them through a single writer.
# A desktop install still uses SQLite and needs none of this.
#
# REQUIRED. The database is not published outside the compose network, but a
# default password would still be a default password.
GENSTUDIO_DB_PASSWORD=genstudio

# Optional — only if you want names other than the defaults.
# GENSTUDIO_DB_NAME=genstudio
# GENSTUDIO_DB_USER=genstudio

# How many connections the app keeps open. Each concurrent request needs one, so
# this is the real ceiling on how much work happens at once. Raise it for a
# larger team; the database's own max_connections (100 by default) is the limit.
# GENSTUDIO_DB_POOL_MAX=10

# Log any statement slower than this many milliseconds, to the backend log the
# Logs panel reads. 0 turns it off.
# GENSTUDIO_SLOW_QUERY_MS=500

# MIGRATING AN EXISTING DEPLOYMENT
# If you already run this server on SQLite, move the data across BEFORE the
# first start on PostgreSQL. Asset files are not touched — only database rows
# move:
#
#   docker compose up -d db
#   docker compose run --rm --entrypoint node genstudio-server \
#     tools/migrate-sqlite-to-postgres.mjs --from ./data/app.db \
#     --to "$GENSTUDIO_DATABASE_URL"
#   docker compose up -d
#
# Until then the server refuses to start, because an empty workspace and a lost
# workspace look identical from the UI. Set this to 1 only when you genuinely
# mean to start empty.
# GENSTUDIO_ALLOW_EMPTY_DATABASE=1

# --- Auth -------------------------------------------------------------------
# REQUIRED — at least 16 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GENSTUDIO_JWT_SECRET=123456Secret123456Secret123456

# REQUIRED — the first administrator, created only while no user exists.
# The password must be at least 8 characters; the server refuses to start if it
# cannot create this account, because it would have no usable login at all.
GENSTUDIO_ADMIN_LOGIN=admin
GENSTUDIO_ADMIN_PASSWORD=12345678

# --- Networking -------------------------------------------------------------
# Set behind a reverse proxy so asset URLs point at the public address.
# PUBLIC_BASE_URL=https://studio.example.com

# X-Forwarded-* headers are TRUSTED BY DEFAULT. If this server is reachable
# directly (not via a proxy), set this to 0 so a client cannot spoof the host
# the API puts into asset URLs.
# TRUST_PROXY_HEADERS=0
