# Default: let Git normalize text files, auto-detecting on commit.
* text=auto

# Shell scripts MUST use LF — CRLF breaks the shebang on Linux/macOS
# ("bad interpreter: /usr/bin/env bash^M"). core.autocrlf=true would otherwise
# convert them on checkout.
*.sh text eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated by tools/gen-db-names.mjs and tools/gen-pg-schema.mjs, which always
# write LF. Without this, text=auto checks them out as CRLF on Windows and
# `npm run check:db` compares CRLF-on-disk against freshly generated LF and
# reports them stale — which is what broke the Windows build in CI.
db/names.js text eol=lf
db/schema.pg.sql text eol=lf
